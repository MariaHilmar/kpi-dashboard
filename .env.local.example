# Pipeline Python (copie de D:\mgi-workspace\.env)
# Supabase — MGI Dashboard (projeto xvcrfouolhnjkxvcxmda)
NEXT_PUBLIC_SUPABASE_URL=https://xvcrfouolhnjkxvcxmda.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — CRUD de usuários (admin). Nunca exponha no browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cache invalidation — chamado pelo pipeline após cada sync
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Autenticacao (Supabase Auth)
# NEXT_PUBLIC_AUTH_REQUIRED=false
# Cadastro publico desligado por padrao; admin cria usuarios em /admin/usuarios
# NEXT_PUBLIC_ALLOW_SIGNUP=true

# SUPABASE_URL=https://xvcrfouolhnjkxvcxmda.supabase.co
